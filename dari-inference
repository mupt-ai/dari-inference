#!/bin/sh
# Checkout entry point. Only the explicit install command may create the runtime.
set -eu
root=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
if { [ "${1:-}" = install ] || { [ "${1:-}" = pull ] && [ "$#" -eq 2 ]; }; } && { [ "$#" -eq 1 ] || { [ "$#" -eq 2 ] && [ "$2" = inkling-2-mini ]; }; }; then
    if [ ! -x "$root/.venv/bin/python" ]; then
        uv venv --python 3.12 "$root/.venv"
    fi
    uv pip install --python "$root/.venv/bin/python" "$root/inkling"
elif [ ! -x "$root/.venv/bin/python" ]; then
    echo 'Runtime not installed. Run: ./dari-inference install' >&2
    exit 1
fi
export PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}"
exec "$root/.venv/bin/python" -P -m inkling.cli "$@"
